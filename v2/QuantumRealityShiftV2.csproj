<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must target .NET Framework 4.8 for ScriptHookVDotNet3 -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>QuantumRealityShiftV2</AssemblyName>
    <RootNamespace>QuantumRealityShiftV2</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>

    <!-- Optional: update to your GTA V\scripts\ folder for auto-copy on build -->
    <GtaScriptsPath>C:\Program Files\Steam\steamapps\common\Grand Theft Auto V\scripts\</GtaScriptsPath>
  </PropertyGroup>

  <Target Name="CopyToGTA" AfterTargets="Build" Condition="Exists('$(GtaScriptsPath)')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GtaScriptsPath)" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)Newtonsoft.Json.dll" DestinationFolder="$(GtaScriptsPath)" ContinueOnError="true" />
    <Copy SourceFiles="$(ProjectDir)..\src\lib\LemonUI.SHVDN3.dll" DestinationFolder="$(GtaScriptsPath)" ContinueOnError="true" />
    <Message Text="Copied v2 mod to: $(GtaScriptsPath)" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />

    <Reference Include="ScriptHookVDotNet3">
      <HintPath>..\src\lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="LemonUI.SHVDN3">
      <HintPath>..\src\lib\LemonUI.SHVDN3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
